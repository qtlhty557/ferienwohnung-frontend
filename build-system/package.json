{
  "name": "fh-build-system",
  "version": "1.0.0",
  "description": "Build system for Ferienwohnungen - JSON to Static HTML with Design System",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:site": "node build.js --site",
    "deploy": "node scripts/deploy.js",
    "deploy:site": "node scripts/deploy.js --site",
    "deploy:cf": "node scripts/deploy-cloudflare.js",
    "deploy:site:cf": "node scripts/deploy-cloudflare.js --site",
    "setup:cf": "node scripts/setup-cloudflare.js",
    "sync:wp": "node scripts/wp-sync.js",
    "sync:site": "node scripts/wp-sync.js --site",
    "new": "node scripts/new-site.js",
    "validate": "node scripts/validate-json.js"
  },
  "dependencies": {
    "nunjucks": "^3.2.4",
    "chokidar": "^3.6.0",
    "glob": "^11.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8",
    "node-fetch": "^3.3.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "inquirer": "^10.0.0",
    "archiver": "^7.0.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  }
}