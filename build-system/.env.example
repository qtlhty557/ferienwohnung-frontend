# WordPress Backend API
WP_API_URL=https://dein-wordpress.de/wp-json/fh/v1

# Auth: Entweder API Key ODER Username + Password
WP_API_KEY=your-api-key-here
# WP_USERNAME=admin
# WP_PASSWORD=your-password

# Cloudflare Pages (für Auto-Deploy via GitHub Actions)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Optional: Für lokale Development
# NODE_ENV=development