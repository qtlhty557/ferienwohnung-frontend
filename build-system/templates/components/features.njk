<div class="features-grid" role="list" aria-label="{{ t('features', lang) }}">
  <!-- Capacity Highlight -->
  <div class="feature-card feature-capacity {% if 'hover-zoom' in design.components.effects %}hover-zoom{% endif %} scroll-reveal" role="listitem">
    <div class="feature-icon" aria-hidden="true">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    </div>
    <div class="feature-content">
      <span class="feature-number">{{ site.max_guests }}</span>
      <h3 class="feature-title">{{ t('sleepsUpTo', lang) }}</h3>
      <p class="feature-desc">{{ t('guests', lang) }}</p>
    </div>
  </div>
  
  <!-- Pre-computed features -->
  {% for feature in features.slice(0, 7) %}
  <div class="feature-card {% if 'hover-zoom' in design.components.effects %}hover-zoom{% endif %} scroll-reveal" role="listitem">
    <div class="feature-icon" aria-hidden="true">
      {{ featureIcons[feature.icon] | safe }}
    </div>
    <h3 class="feature-title">{% if lang == 'de' %}{{ feature.de }}{% else %}{{ feature.en }}{% endif %}</h3>
  </div>
  {% endfor %}
</div>