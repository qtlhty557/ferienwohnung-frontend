<div class="gallery gallery-grid" role="list" aria-label="{{ t('gallery', lang) }}">
  <div class="grid-layout">
    {% for image in site.images %}
    <figure class="grid-item {% if 'hover-zoom' in design.components.effects %}hover-zoom{% endif %} scroll-reveal" role="listitem">
      <img src="{{ image }}" alt="{{ t('gallery', lang) }} {{ loop.index }}" loading="{{ 'eager' if loop.index <= 6 else 'lazy' }}">
      <figcaption class="grid-caption">{{ t('gallery', lang) }} {{ loop.index }}</figcaption>
    </figure>
    {% endfor %}
  </div>
</div>