<section class="hero hero-split {% if 'parallax-hero' in design.components.effects %}parallax-hero{% endif %} scroll-reveal" 
         aria-labelledby="hero-title"
         style="{% if site.images[0] %}background-image: url('{{ site.images[0] }}');{% endif %}">
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-split-content">
      <div class="hero-text scroll-reveal">
        <h1 id="hero-title" class="hero-title {% if 'text-reveal' in design.components.effects %}text-reveal{% endif %}">
          <span>{% if lang == 'de' %}{{ site.name_de }}{% else %}{{ site.name_en or site.name_de }}{% endif %}</span>
        </h1>
        <p class="hero-subtitle {% if 'text-reveal' in design.components.effects %}text-reveal{% endif %}">
          <span>{% if lang == 'de' %}{{ site.place_de }}{% else %}{{ site.place_en or site.place_de }}{% endif %}</span>
        </p>
        {% if site.description_de or site.description_en %}
        <div class="hero-description {% if 'text-reveal' in design.components.effects %}text-reveal{% endif %}">
          <span>{% if lang == 'de' %}{{ site.description_de }}{% else %}{{ site.description_en or site.description_de }}{% endif %} | safe }}</span>
        </div>
        {% endif %}
        <div class="hero-meta">
          <div class="meta-item">
            <span class="meta-icon" aria-hidden="true">👥</span>
            <span>{{ site.max_guests }} {{ t('guests', lang) }}</span>
          </div>
          <div class="meta-item">
            <span class="meta-icon" aria-hidden="true">🌙</span>
            <span>{{ site.min_nights }} {{ t('minNights', lang) }}</span>
          </div>
          <div class="meta-item">
            <span class="meta-icon" aria-hidden="true">💰</span>
            <span>{{ t('from', lang) }} {{ site.price_per_night | currency(site.currency, lang) }} / {{ t('night', lang) }}</span>
          </div>
        </div>
        <a href="#inquiry" class="btn btn-primary btn-lg magnetic-btn">
          <span>{{ t('bookNow', lang) }}</span>
        </a>
      </div>
      <div class="hero-mini-gallery scroll-reveal" aria-label="{{ t('gallery', lang) }}">
        <div class="mini-gallery-grid">
          {% set miniImages = site.images.slice(1, 5) %}
          {% for image in miniImages %}
          <img src="{{ image }}" alt="{{ t('gallery', lang) }} {{ loop.index + 1 }}" loading="lazy" class="mini-gallery-img hover-zoom">
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>