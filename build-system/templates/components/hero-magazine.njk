<section class="hero hero-magazine scroll-reveal" aria-labelledby="hero-title">
  <div class="container">
    <div class="magazine-hero-grid">
      <div class="magazine-hero-main {% if 'parallax-hero' in design.components.effects %}parallax-hero{% endif %}" 
           style="{% if site.images[0] %}background-image: url('{{ site.images[0] }}');{% endif %}"
           aria-hidden="true">
        <div class="magazine-overlay"></div>
      </div>
      <div class="magazine-hero-content scroll-reveal">
        <span class="magazine-category">{% if lang == 'de' %}{{ site.place_de }}{% else %}{{ site.place_en or site.place_de }}{% endif %}</span>
        <h1 id="hero-title" class="hero-title {% if 'text-reveal' in design.components.effects %}text-reveal{% endif %}">
          <span>{% if lang == 'de' %}{{ site.name_de }}{% else %}{{ site.name_en or site.name_de }}{% endif %}</span>
        </h1>
        <p class="magazine-lead {% if 'text-reveal' in design.components.effects %}text-reveal{% endif %}">
          {% if lang == 'de' %}{{ site.description_de | striptags | truncate(200) | safe }}{% else %}{{ site.description_en | striptags | truncate(200) | safe }}{% endif %}
        </p>
        <div class="magazine-meta">
          <div class="meta-item">
            <span class="meta-label">{{ t('guests', lang) }}</span>
            <span class="meta-value">{{ site.max_guests }}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">{{ t('minNights', lang) }}</span>
            <span class="meta-value">{{ site.min_nights }}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">{{ t('from', lang) }}</span>
            <span class="meta-value">{{ site.price_per_night | currency(site.currency, lang) }}</span>
          </div>
        </div>
        <a href="#inquiry" class="btn btn-primary magnetic-btn">
          <span>{{ t('bookNow', lang) }}</span>
        </a>
      </div>
      {% if site.images[1] %}
      <div class="magazine-hero-secondary {% if 'parallax-hero' in design.components.effects %}parallax-hero{% endif %}" 
           style="background-image: url('{{ site.images[1] }}');"
           aria-hidden="true">
        <div class="magazine-overlay"></div>
      </div>
      {% endif %}
    </div>
  </div>
</section>